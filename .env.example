# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Alpaca paper trading keys (https://app.alpaca.markets -> Paper account -> API keys)
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# Must stay on the paper endpoint. Anything else is refused unless ALLOW_LIVE=true
# AND you type a confirmation phrase at an interactive prompt.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Earnings data providers (milestone 2)
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=

# Leave unset. Only for a deliberate, manual move to live money (out of scope for this project).
# ALLOW_LIVE=
